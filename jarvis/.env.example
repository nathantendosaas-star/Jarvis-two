# JARVIS AI OS — Environment Configuration
# Copy this to .env and fill in your values.

# Required: Your Gemini API key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional: OpenRouter API key for Deepseek/Gemma backup models
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY_HERE"

# Login password for the JARVIS UI (single-user auth)
JARVIS_PASSWORD="jarvis"

# SQLite database path (relative to project root)
DATABASE_URL="sqlite+aiosqlite:///.storage/jarvis.db"

# Local file upload storage directory
STORAGE_DIR=".storage/uploads"

# JWT secret key — change this to a random string in production
SECRET_KEY="jarvis-secret-key-change-in-production"

# Debug mode (true/false)
DEBUG="false"
